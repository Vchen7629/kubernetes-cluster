apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: "cloudflared-{{ cf_tunnel_name }}"
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source: 
    chart: '{{ cloudflared_vars.kubernetes.helm.chart.name }}'
    repoURL: '{{ cloudflared_vars.kubernetes.helm.repository.url }}'
    targetRevision: '{{ cloudflared_vars.kubernetes.helm.chart.version }}'

    helm:
      valuesObject:
        metrics:
          enabled: {{ cloudflared_vars.kubernetes.metrics.enable }}
          port: '{{ cloudflared_vars.kubernetes.metrics.port }}'

        managed:
          enabled: false

        local:  
          enabled: true
          auth:
            tunnelID: "{{ tunnel_id }}"
            accountTag: "{{ account_tag }}"
            tunnelName: "{{ cf_tunnel_name }}"
            tunnelSecret: "{{ tunnel_secret }}"

          ingress:
            - hostname: '{{ cf_tunnel_hostname }}'
              service: '{{ cf_tunnel_service }}'
              {% if cf_tunnel_origin_request %}
              originRequest: {{ cf_tunnel_origin_request | to_yaml }}
              {% endif %}

            - hostname: '*.{{ cf_tunnel_hostname }}'
              service: '{{ cf_tunnel_service }}'
            
            - service: http_status:404
              
        resources:
          limits:
            memory: '{{ cloudflared_vars.kubernetes.resources.limits.memory }}'
          requests:
            cpu: '{{ cloudflared_vars.kubernetes.resources.requests.cpu }}'
            memory: '{{ cloudflared_vars.kubernetes.resources.requests.memory }}'
  destination:
    server: https://kubernetes.default.svc
    namespace: "cloudflare-tunnel-{{ cf_tunnel_name }}"

  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true