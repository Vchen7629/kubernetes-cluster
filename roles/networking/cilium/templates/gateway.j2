apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  annotations:
{% for key, value in cilium_map.gateway.hubble.ui.annotations | default({}) | dictsort %}
    {{ key }}: {{ value }}
{% endfor %}
  name: {{ cilium_vars.kubernetes.gateway.service }}
  namespace: {{ cilium_vars.kubernetes.namespace }}
spec:
  gatewayClassName: cilium
  listeners:
    - name: frontend-http
      port: 80
      protocol: HTTP
      allowedRoutes:
        kinds:
          - group: gateway.networking.k8s.io
            kind: HTTPRoute
        namespaces:
          from: All